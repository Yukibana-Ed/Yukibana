{
  // The CI workflows' scripts, which Node runs as they are (type stripping): no syntax it cannot strip.
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.mts"]
}
