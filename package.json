{
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "setup:ide": "pnpm --filter \"{ide/**}...\" install && pnpm run check:theia",
    "setup:cloud": "pnpm --filter \"{cloud/**}...\" install",
    "setup:cli": "pnpm --filter @yukibana/cli... install",
    "check:theia": "node node_modules/@theia/cli/bin/theia.js check:theia-version",
    "build": "node ide/scripts/cli.mts build",
    "start": "node ide/scripts/cli.mts start",
    "package": "node ide/scripts/cli.mts package",
    "download:plugins": "node ide/scripts/cli.mts download:plugins",
    "watch": "node ide/scripts/cli.mts watch",
    "new:ext": "node ide/scripts/cli.mts new:ext",
    "clean": "pnpm -r --if-present run clean",
    "lint": "pnpm run lint:root && pnpm -r run lint",
    "lint:root": "oxlint .github/scripts cloud/dev oxfmt.config.mts vitest.config.mts",
    "lint:fix": "pnpm run lint:root --fix && pnpm -r run lint --fix",
    "typecheck": "pnpm run typecheck:root && pnpm -r run typecheck",
    "typecheck:root": "tsc -p .github/scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:root": "vitest run --project ci-scripts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @yukibana/ide-e2e exec playwright test",
    "check:licenses": "node .github/scripts/licenses.mts",
    "check:release-age": "node .github/scripts/release-age-excludes.mts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
