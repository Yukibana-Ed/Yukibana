{
  "private": true,
  "name": "@yukibana/cloud-db",
  "description": "The cloud's database: the Supabase project (migrations, pgTAP tests, seeds) and the deploy-time bootstrap in ops/, with the Supabase CLI and squawk that work on them.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "scripts": {
    "lint": "squawk --assume-in-transaction --exclude=require-concurrent-index-creation,prefer-robust-stmts supabase/migrations/*.sql && oxlint supabase/functions",
    "start": "supabase start",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "test:db": "supabase test db"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "squawk-cli": "catalog:",
    "supabase": "catalog:"
  }
}
