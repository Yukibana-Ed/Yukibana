# Local development overrides for wrangler.jsonc, which holds production
# values. A key here wins over the same key there; keys only there still
# apply. `pnpm --filter @yukibana/cloud-dev dev:vars` writes the real file from the running stack.
#
# Copy to .dev.vars (gitignored) if you would rather fill it in by hand.

# `pnpm --filter @yukibana/cloud-db exec supabase status` prints the local publishable (anon) key. It is a fixed
# demo value, not a secret, but it is read the same way the production one is.
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The OAuth client the CLI and the IDE log in through: what
# `node cloud/dev/scripts/oauth-client.mjs` prints. Empty, they log in with GitHub
# directly, as before.
SUPABASE_OAUTH_CLIENT_ID=
# Auth's local site_url (cloud/db/supabase/config.toml), where `pnpm --filter @yukibana/cloud-web dev` serves.
SITE_URL=http://127.0.0.1:5173

# RustFS, from cloud/dev/compose.yml. It wants a real region name; R2 says "auto".
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# The GitHub App teachers link a project's repository through (docs/cloud/github.md).
# All three or none: none leaves linking off, and the project page says nothing about
# GitHub. Register a development App of your own, with the callback URL
# http://127.0.0.1:5173/auth/github/return.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# Optional: a template repository (owner/name) whose workflow publishes with OIDC.
# GITHUB_TEMPLATE=
