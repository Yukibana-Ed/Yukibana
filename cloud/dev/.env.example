# Copy to cloud/dev/.env. Read by cloud/dev/.devcontainer/setup.sh, which exports
# them for `supabase start` (config.toml refers to these with env()); without a
# devcontainer, export them yourself first (docs/cloud/README.md, "Start").

# A GitHub OAuth App for local login: https://github.com/settings/developers
#   Authorization callback URL: http://127.0.0.1:54321/auth/v1/callback
# Auth starts only with both set; with these placeholders the stack starts,
# but "Continue with GitHub" fails.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=not-configured
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=not-configured

# Same Supabase instance, two URLs: the devcontainer and the Supabase containers
# are siblings, so they do not share a "localhost". The CLI prints whichever is
# right for where you run `pnpm --filter @yukibana/cloud-db exec supabase status`.
#   inside the devcontainer:  http://host.docker.internal:54321
#   in the host browser:      http://localhost:54321
