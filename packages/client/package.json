{
  "name": "@yukibana/client",
  "description": "The library the IDE and the CLI share: the registry client, login and sessions, packing, unpacking and assembly of Yukibana course projects.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "homepage": "https://github.com/Yukibana-Ed/Yukibana#readme",
  "bugs": {
    "url": "https://github.com/Yukibana-Ed/Yukibana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukibana-Ed/Yukibana.git",
    "directory": "packages/client"
  },
  "type": "module",
  "files": [
    "lib",
    "yukibana.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./lib/library.d.ts",
      "default": "./lib/library.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./assembly": {
      "types": "./lib/assembly.d.ts",
      "default": "./lib/assembly.js"
    },
    "./yukibana.schema.json": "./yukibana.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsc --build tsconfig.build.json",
    "clean": "rimraf lib tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "schema": "vitest run tests/schema.test.ts --update"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yukibana/fixtures": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "ignore": "catalog:",
    "modern-tar": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
