{
  // Everything in ../ide/devcontainer.json, plus the cloud's local stack (Supabase
  // and the bucket), started on every start. Pick this one to work on the cloud's
  // database, its Worker against a real stack, or its integration tests.
  "name": "Yukibana, with the local cloud",
  // Node 24 and a C++ toolchain, plus the headers the IDE's native modules need.
  "build": { "dockerfile": "../Dockerfile" },

  "features": {
    // moby:false is required - the base image is Debian trixie, which has no
    // 'moby-cli' package and the feature's default fails to install there.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },

  // Mount the workspace at the SAME absolute path it has on the host. Load-bearing:
  // the Supabase CLI and docker compose run in here but drive the HOST daemon, so
  // the bind mounts they request (cloud/db/supabase/functions -> edge runtime) are resolved
  // against host paths. Change this and edge functions mount as an empty directory.
  // On Windows this is why the repository is cloned inside WSL: a C:\ path is not one here.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // The CLI reaches the services on their published ports and defaults to
  // 127.0.0.1, which in here is this container. Point it at the host gateway.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "SUPABASE_SERVICES_HOSTNAME": "host.docker.internal",
    // The Worker's local database, seen from in here. On the host the value in
    // wrangler.jsonc applies; this overrides it because localhost differs.
    "WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE": "postgres://yukibana_app:yukibana@host.docker.internal:54322/postgres"
  },

  "remoteUser": "node",
  // The pnpm the root's packageManager names, installed globally so that
  // setup.sh and the cloud/dev scripts find it on PATH, then the whole workspace
  // (the IDE, the cloud, the CLI), which pnpm runs on the root's devEngines
  // Node. Not `npx pnpm` here: npm enforces that exact Node release itself and
  // cannot download it, so on any other 24.x it stops before pnpm starts.
  "postCreateCommand": "npm install --global \"$(node -p \"require('./package.json').packageManager\")\" && pnpm install --frozen-lockfile",
  "postStartCommand": ".devcontainer/cloud/setup.sh",

  // The Supabase and RustFS ports are published by the host daemon, so they are
  // already on the host's localhost. What runs in here is the SvelteKit dev
  // server, which VS Code forwards when it starts.
  "portsAttributes": {
    "5173": { "label": "Cloud (SvelteKit)" }
  },

  "customizations": {
    "vscode": { "extensions": ["svelte.svelte-vscode", "denoland.vscode-deno", "oxc.oxc-vscode"] }
  }
}
